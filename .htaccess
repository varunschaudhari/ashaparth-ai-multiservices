# AshaParth AI Multiservices: Apache / LiteSpeed configuration

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Uncomment both lines once SSL is active on the domain to force HTTPS
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct web access to application code, storage and SQL files
    RewriteRule ^(app|storage|database|tools|dist)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(sql|md|log|example\.php)$ - [F,L]

    # Serve real files in /assets directly, plus SSL validation files (AutoSSL)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(assets|\.well-known)/ - [L]

    # Everything else goes to the front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|woff2?|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# Upload limits (some hosts ignore these; set them in cPanel > PHP settings if needed)
<IfModule mod_php.c>
    php_value upload_max_filesize 6M
    php_value post_max_size 12M
</IfModule>
